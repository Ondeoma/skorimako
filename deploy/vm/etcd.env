# /etc/default/etcd（例: skorimako1。3台で名前とIPだけ変える）
ETCD_NAME=skorimako1
ETCD_DATA_DIR=/var/lib/etcd
ETCD_LISTEN_PEER_URLS=http://10.0.0.11:2380
ETCD_LISTEN_CLIENT_URLS=http://10.0.0.11:2379,http://127.0.0.1:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://10.0.0.11:2380
ETCD_ADVERTISE_CLIENT_URLS=http://10.0.0.11:2379
ETCD_INITIAL_CLUSTER=skorimako1=http://10.0.0.11:2380,skorimako2=http://10.0.0.12:2380,skorimako3=http://10.0.0.13:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=skorimako-etcd
# 社内ネットワーク内のみで使う前提。ネットワークを分けられない場合はTLS（--cert-file 等）を有効にする
