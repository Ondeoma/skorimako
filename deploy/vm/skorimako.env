# /etc/skorimako/skorimako.env（全ノードで同じ内容。NODE_ID だけノードごとに変える）
NODE_ID=node1
HTTP_PORT=8080
# ほかのノードからこのノードを呼ぶ URL（書き出す前の行の問い合わせ）。ノードごとに変える
NODE_URL=http://10.0.0.11:8080
# OTLP/gRPC（0 で止める）
GRPC_PORT=4317
PUBLIC_URL=https://observe.example.com

# PostgreSQL（Patroni）。複数ホスト + targetServerType=primary でプライマリにつなぐ
DATABASE_URL=jdbc:postgresql://10.0.0.11:5432,10.0.0.12:5432,10.0.0.13:5432/skorimako?targetServerType=primary&connectTimeout=3&tcpKeepAlive=true
DATABASE_USER=skorimako
DATABASE_PASSWORD=change-me

# OIDC（Authorization Code + PKCE）。リダイレクト先は {PUBLIC_URL}/auth/callback
OIDC_ISSUER=https://idp.example.com/realms/example
OIDC_CLIENT_ID=skorimako
OIDC_CLIENT_SECRET=change-me
#OIDC_GROUPS_CLAIM=groups
ADMIN_GROUPS=skorimako-admins

# 秘密の値の暗号化（通知先の Webhook の署名の鍵）。全ノード共通、16文字以上。変えると保存済みの値を読めなくなる
APP_SECRET=change-me-to-a-long-random-value

# S3 互換ストレージ（観測データの Parquet）。全ノードで同じバケット
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=skorimako
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
#S3_PREFIX=prod/

# ノードの手元のディレクトリ（取り込みの WAL・検索のキャッシュ・一時ファイル）。速いディスクに置く
DATA_DIR=/var/lib/skorimako
STATIC_DIR=/opt/skorimako/current/static

# 取り込み・保持
FLUSH_SECONDS=10
RETENTION_DAYS=30
MAX_INGEST_MB=32
#WAL_SYNC=true            # 受けるたびに fsync する（遅いが、OS ごと落ちても失わない）

# 検索（DuckDB）
DUCKDB_MEMORY=2GB
DUCKDB_THREADS=4
QUERY_CONCURRENCY=4
QUERY_TIMEOUT_SECONDS=60
CACHE_MAX_GB=20

# stui への通知（stui の OAUTH_CLIENTS に skorimako を登録する。redirectUri は {PUBLIC_URL}/api/integrations/stui/callback）
#STUI_URL=https://chat.example.com
#STUI_CLIENT_ID=skorimako
#STUI_CLIENT_SECRET=change-me
# stui がリンクの要約を読む（stui をクライアントとして登録する）
#OAUTH_CLIENTS=[{"id":"stui","secret":"…16文字以上…","redirectUri":"https://chat.example.com/api/integrations/skorimako/callback","name":"stui","scopes":["read"]}]
#SELF_MONITOR=true

TIMEZONE=Asia/Tokyo
